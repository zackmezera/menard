// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`alignPrompt > matches the snapshot 1`] = `
{
  "prompt": "{
  "source": [
    {
      "n": 1,
      "text": "Según el Sr. Pérez, Borges leyó a Poe."
    },
    {
      "n": 2,
      "text": "Esa lectura fue decisiva."
    }
  ],
  "target": [
    {
      "n": 1,
      "text": "According to Mr. Pérez, Borges read Poe."
    },
    {
      "n": 2,
      "text": "He read him in Geneva."
    },
    {
      "n": 3,
      "text": "That reading was decisive."
    }
  ]
}

Your previous answer was rejected: target sentence 2 is missing. Return corrected JSON.",
  "schema": {
    "additionalProperties": false,
    "properties": {
      "groups": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "loose": {
              "type": "boolean",
            },
            "src": {
              "items": {
                "minimum": 1,
                "type": "integer",
              },
              "type": "array",
            },
            "tgt": {
              "items": {
                "minimum": 1,
                "type": "integer",
              },
              "type": "array",
            },
          },
          "required": [
            "src",
            "tgt",
            "loose",
          ],
          "type": "object",
        },
        "minItems": 1,
        "type": "array",
      },
    },
    "required": [
      "groups",
    ],
    "type": "object",
  },
  "system": "You align a Spanish text with its existing English translation, sentence by sentence. You never translate or rewrite anything.

The user message is a JSON object with the numbered sentences of one block: "source" in the original and "target" in the translation.

Return only JSON of the form {"groups": [{"src": [1], "tgt": [1, 2], "loose": false}]}.

Rules:
1. Each group pairs consecutive source sentences with the consecutive target sentences that render them: one to one, one to many or many to one. Keep groups as small as the correspondence allows.
2. Every source and every target sentence number appears in exactly one group, and the groups follow the order of both texts.
3. When a stretch on one side has no counterpart on the other, give it its own group with an empty list for the other side instead of forcing a match. Never leave both lists empty.
4. Every sentence in a group must have its own content rendered on the other side of that group; a shared name (an author cited, the subject of the text) or a single shared word is not a rendering. Test each sentence on its own: one whose content the other side does not render (a quotation, aside or example the translation leaves out, together with its attribution) is its own group with an empty list for the other side, even when its neighbour is rendered. Never fold it into the neighbour's group to avoid an empty list.
5. For example, source 1 "“Time is a river that carries me away”, writes Borges." and source 2 "Reading, too, carries us off, voraciously." against target 1 "Borges is read voraciously." give {"src": [1], "tgt": [], "loose": false} and {"src": [2], "tgt": [1], "loose": true}: the quotation is not translated, and the shared name does not make it so.
6. Set "loose" to true when the correspondence is approximate (a free rendering, a partial overlap, or content moved within the group); otherwise false. A faithful translation that changes word order, idiom or punctuation is not loose.
7. Return sentence numbers only, never text.",
}
`;

exports[`outlinePrompt > matches the snapshot and pins the heading count in the schema 1`] = `
{
  "prompt": "{
  "documentTitle": "Ficciones",
  "headings": [
    "Prólogo",
    "El jardín de senderos que se bifurcan"
  ]
}",
  "schema": {
    "additionalProperties": false,
    "properties": {
      "headings": {
        "items": {
          "type": "string",
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array",
      },
    },
    "required": [
      "headings",
    ],
    "type": "object",
  },
  "system": "You translate the headings of a Spanish document into English.

The user message is a JSON object with "documentTitle" for orientation, the "headings" in document order, and possibly the reader's "extraInstructions", which you follow unless they conflict with the rules below.

Return only JSON of the form {"headings": ["…"]}.

Rules:
1. Return exactly one heading per input heading, in the same order.
2. Each heading is one line, without # markers.
3. Keep numbering, wikilinks [[…]] and Markdown emphasis. Return a heading that needs no translation, such as a proper name, unchanged.",
}
`;

